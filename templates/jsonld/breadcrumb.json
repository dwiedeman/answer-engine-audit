{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{ORIGIN}/" },
    { "@type": "ListItem", "position": 2, "name": "{SECTION}", "item": "{ORIGIN}/{SECTION_PATH}/" },
    { "@type": "ListItem", "position": 3, "name": "{PAGE_TITLE}" }
  ]
}
